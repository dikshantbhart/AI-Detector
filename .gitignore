# ====================================================================
# Git Ignore Rules for AI Answer Reliability Tracker
# ====================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# SQLite Database Files (Generated at runtime via schema.sql / app.py)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Generated Export Reports
*.csv
claims_report.csv
AI_Answer_Reliability_Report.csv

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs & Code Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*
.Spotlight-V100
.Trashes

# Logs & Temporary Files
*.log
*.tmp
*.bak
*.pid

# Distribution & Build Artifacts
build/
dist/
*.egg-info/
*.egg
